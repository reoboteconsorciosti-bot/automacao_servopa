# URL de conexão com o banco PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/servopa_automacao

# URL do frontend para CORS
FRONTEND_URL=http://localhost:3000

# Habilita stack trace detalhado em erros 500 (dev = 1, producao = 0)
DEBUG=1

# Configurações de Automação (Selenium / GeckoDriver / Firefox)
GECKODRIVER_PATH=
FIREFOX_BINARY_PATH=
FIREFOX_PROFILE_PATH=
# Pasta onde o Firefox salva os PDFs baixados antes de serem renomeados/movidos
# para LANCES_DIR/{consultor}. Obrigatória — sem ela a automação falha ao tentar
# localizar o PDF do lance registrado.
DOWNLOAD_DIR=
# Pasta final onde os PDFs renomeados são organizados por consultor (padrão: "Lances")
LANCES_DIR=
HEADLESS=false

# Credenciais e URL de acesso ao Servopa
SERVOPA_URL=https://www.consorcioservopa.com.br/vendas/login
SERVOPA_LANCES_URL=https://www.consorcioservopa.com.br/vendas/lances
CPF_CNPJ=
SENHA=


